<?xml version="1.0" encoding="utf-8"?>
<!--
  明文流量白名单（Folia Android）。

  为什么需要：Folia 的音源服务（网易云 / QQ / 酷狗）在 Android 上必须指向一个外部 HTTP 服务 ——
  它们本身是 Node 服务（网易云是 @neteasecloudmusicapienhanced/api），只能跑在桌面 Electron 主进程
  或一台服务器上，WebView 里跑不起来。所以 WebView 只能发 HTTP 请求去打它。

  当前这一条对应本机局域网服务 http://192.168.0.104:3000，由 .env.local 的
  VITE_NETEASE_API_BASE 指定。Windows 侧配套放行了一条同名防火墙规则
  （Private profile + LocalSubnet），见 docs/dev/CHANGELOG-RELEASE.md。

  为什么只放行这一条而不是全局 usesCleartextTraffic="true"：
  App 的 HTML / JS / CSS 全部打进 APK assets，运行时只从 https://localhost 加载本地文件，
  不访问任何外部 CDN（CDN importmap 已在构建期剥离，见 dev/android/stripCdnImportmapPlugin.mjs），
  所以明文流量没有别的正当用途，收窄到具体 IP 更稳妥。

  换网络后本机 IP 会变 —— 改这里 + .env.local，再重新构建即可。
  如果之后把音源换成 natfrp / Vercel 的 https 地址，本文件可以整个删掉，
  同时把 capacitor.config.ts 的 server.cleartext 改回 false。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.104</domain>
    </domain-config>
</network-security-config>
